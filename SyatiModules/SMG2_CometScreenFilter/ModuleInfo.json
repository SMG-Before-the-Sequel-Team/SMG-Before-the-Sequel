        },
        {
          "Comet": "Dark",
          "Frame": "2"
        },
        {
          "Comet": "Purple",
          "Frame": "3"
        },
        {
          "Comet": "Exterminate",
          "Frame": "4"
        },
        {
          "Comet": "Mimic",
          "Frame": "5"
        },
        {
          "Comet": "Ghost",
          "Frame": "6"
        },
        {
          "Comet": "Quick",
          "Frame": "7"
        },
        {
          "Comet": "Horror",
          "Frame": "8"
        },
        {
          "Comet": "Rainbow",
          "Frame": "9"
        }
      ]
    }
  ]
}