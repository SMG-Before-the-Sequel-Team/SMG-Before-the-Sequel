{
  "Name": "SMG2 Comet Screen Filter Colors",
  "Author": "Super Hackio",
  "Description": "Restores the Custom Comet Screen Filter colors that were used in SMG1.",
  "SupportedGames": [ "SB4" ],

  "ModuleExtensionDefinition": [
    {
      "Name": "CometScreenFilter",
      "CodeGenSource": "GEN_CometScreenFilter.h",
      "CodeGenDestination": "codebuild/ModuleData_ExtCometScreenFilter.h",
      "Variables": [
        "Comet",
        "Frame"
      ],
      "CodeGenData": [
        {
          "ReplaceTargetName": "CometScreenFilterList",
          "ReplaceFormatData": "    {{ \"{0}\", {1} }},"
        }
      ]
    }
  ],
  "ModuleData": [
    {
      "CometScreenFilter": [
